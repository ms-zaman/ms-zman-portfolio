---
/**
 * BlogLayout — the light "Sky" shell for /blog and /404.
 * Shares the homepage design system (sky-tokens + composition + utility, Inter
 * fonts, SkyNav + SiteFooter) so the blog matches the redesign. Replaces the old
 * dark BaseLayout. Keeps ClientRouter view transitions and GA.
 */
import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import defaultFeaturedImage from '../images/ms-zaman-featured-img.webp';
import Analytics from '../components/Analytics.astro';
import Clarity from '../components/Clarity.astro';
import SkyNav from '../components/SkyNav.astro';
import SiteFooter from '../components/sky/SiteFooter.astro';
import '../styles/sky-tokens.css';
import '../styles/sky-base.css';
import '../styles/sky-composition.css';
import '../styles/sky-utilities.css';
import '../styles/sky-blog.css';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  canonicalPath?: string;
  ogImage?: string | ImageMetadata;
  /** Path of this page's markdown twin, e.g. `/blog/some-post.md`. Only the
   *  posts have one — the archive index and 404 pass nothing. */
  markdownPath?: string;
  /** Keep this page out of search indexes (the 404, which is reachable at a
   *  real URL and was otherwise indexable by default). */
  noindex?: boolean;
  /** Present only on a post. Drives the BlogPosting structured data, which is
   *  how a search engine or an AI assistant attributes the writing to a person
   *  and a date — without it the posts are anonymous, undated prose. */
  article?: {
    title: string;
    description: string;
    date: Date;
    tags: string[];
    readTime: string;
    wordCount: number;
  };
}

const {
  title = 'Sharfuzzaman · WordPress Developer | Elementor & Gutenberg',
  description = 'Sharfuzzaman is a WordPress Developer based in Dhaka, Bangladesh. 5+ years building pixel perfect, production ready WordPress experiences with Elementor and Gutenberg.',
  ogTitle = title,
  ogDescription = description,
  canonicalPath = '/',
  ogImage = defaultFeaturedImage,
  markdownPath,
  noindex = false,
  article,
} = Astro.props;

const site = Astro.site ?? new URL('https://sharfuzzaman.com');
const canonicalURL = new URL(canonicalPath, site);
const ogImageSrc = typeof ogImage === 'string' ? ogImage : ogImage.src;
const ogImageWidth = typeof ogImage === 'string' ? undefined : ogImage.width;
const ogImageHeight = typeof ogImage === 'string' ? undefined : ogImage.height;
const ogImageURL = new URL(ogImageSrc, site);
const markdownURL = markdownPath ? new URL(markdownPath, site).href : null;

// "6 min read" -> "PT6M". Schema.org wants an ISO 8601 duration; the human
// string stays in the UI. Falls back to undefined rather than emitting a
// malformed value if the frontmatter ever stops leading with a number.
const readMinutes = article?.readTime.match(/\d+/)?.[0];

// BlogPosting, linked by @id to the Person and WebSite that SkyLayout defines
// on the homepage, so the graph resolves to one author entity across the site
// rather than a separate anonymous author per post.
const articleLd = article && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${canonicalURL.href}#post`,
  headline: article.title,
  description: article.description,
  datePublished: article.date.toISOString(),
  dateModified: article.date.toISOString(),
  author: {
    '@type': 'Person',
    '@id': `${site.origin}/#person`,
    name: 'Sharfuzzaman',
    url: site.origin,
  },
  publisher: { '@id': `${site.origin}/#person` },
  isPartOf: { '@id': `${site.origin}/#website` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.href },
  url: canonicalURL.href,
  image: ogImageURL.href,
  keywords: article.tags,
  wordCount: article.wordCount,
  inLanguage: 'en',
  ...(readMinutes ? { timeRequired: `PT${readMinutes}M` } : {}),
};

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#3f86cf" />
    <meta name="description" content={description} />
    <meta name="author" content="Sharfuzzaman" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    {ogImageWidth && <meta property="og:image:width" content={ogImageWidth.toString()} />}
    {ogImageHeight && <meta property="og:image:height" content={ogImageHeight.toString()} />}
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Sharfuzzaman" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageURL} />

    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Agent discovery — see the matching block in SkyLayout. -->
    {markdownURL && <link rel="alternate" type="text/markdown" href={markdownURL} />}
    <link rel="api-catalog" href="/.well-known/api-catalog" />
    <link rel="describedby" type="text/plain" href="/llms.txt" />
    {articleLd && <script type="application/ld+json" set:html={JSON.stringify(articleLd)} is:inline></script>}

    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.clarity.ms" />

    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-inter-tight" preload />
    <ClientRouter />

    <!-- Both tags now load themselves on requestIdleCallback (see src/scripts/ga.ts
         and clarity.ts), so neither competes with the CSS or the fonts. -->
    <Analytics />
    <Clarity />
  </head>
  <body class="sky">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <SkyNav />
    <main id="main-content" class="blog-main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
