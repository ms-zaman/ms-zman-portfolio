---
/**
 * SkyLayout — the light "Sky" theme shell for the homepage (and styleguide).
 * The blog/404 use the sibling BlogLayout, which shares the same light Sky
 * design system (tokens + composition + utility, Inter fonts, SkyNav/SiteFooter).
 */
import { Font } from 'astro:assets';
import Analytics from '../components/Analytics.astro';
import Clarity from '../components/Clarity.astro';
// CUBE CSS layer order (see src/styles/CUBE-CSS.md): tokens/axioms → composition → utility.
// Utility loads last so it wins among the global sheets; component <style> Blocks
// (Astro-scoped, higher specificity) still override both.
import '../styles/sky-tokens.css';
import '../styles/sky-base.css';
import '../styles/sky-composition.css';
import '../styles/sky-utilities.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Keep this page out of search indexes (e.g. the internal styleguide). */
  noindex?: boolean;
}

const {
  title = 'Sharfuzzaman — WordPress Developer | Elementor & Gutenberg',
  description = 'WordPress Developer specializing in Elementor, Gutenberg and pixel-perfect frontend implementation, with 5+ years of production web development experience.',
  image = '/og.jpg',
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://sharfuzzaman.com');
const canonical = new URL(Astro.url.pathname, site).href;
// Only the homepage has a markdown twin (src/pages/index.md.ts) — the styleguide
// that also uses this layout has none, so it must not advertise one.
const markdownHref = Astro.url.pathname === '/' ? new URL('/index.md', site).href : null;
const ogImage = new URL(image, site).href;

// Structured data — Person + WebSite (helps search engines model the site owner).
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.origin}/#person`,
      name: 'Sharfuzzaman',
      alternateName: 'MS Zaman',
      url: site.origin,
      image: ogImage,
      jobTitle: 'WordPress Developer',
      description,
      sameAs: ['https://github.com/ms-zaman', 'https://www.linkedin.com/in/sharfuzzaman/'],
      knowsAbout: [
        'WordPress',
        'Elementor',
        'Gutenberg',
        'WooCommerce',
        'WordPress Theme Development',
        'Pixel-perfect UI Implementation',
        'Frontend Development',
        'React',
        'PHP',
        'Astro',
      ],
      worksFor: { '@type': 'Organization', name: 'Startise' },
      seeks: {
        '@type': 'Demand',
        name: 'Remote WordPress / Web Developer role',
      },
      address: { '@type': 'PostalAddress', addressLocality: 'Dhaka', addressCountry: 'BD' },
    },
    {
      '@type': 'WebSite',
      '@id': `${site.origin}/#website`,
      name: 'Sharfuzzaman',
      url: site.origin,
      author: { '@id': `${site.origin}/#person` },
      inLanguage: 'en',
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Sharfuzzaman" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#3f86cf" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sharfuzzaman" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sharfuzzaman — WordPress Developer specializing in Elementor & Gutenberg." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Agent discovery: the markdown twin of this page, and the API catalog
         describing every machine-readable endpoint. Mirrored as a Link response
         header in netlify.toml for clients that never parse the HTML. -->
    {markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} />}
    <link rel="api-catalog" href="/.well-known/api-catalog" />
    <link rel="describedby" type="text/plain" href="/llms.txt" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline></script>

    <!-- Warm the third-party origins the page will reach for anyway: the two
         analytics tags, the live-weather API the hero calls after hydration, and
         the CDN behind the lazy work thumbnails. DNS only, deliberately — not one
         of the four is on the critical path (GA and Clarity both wait for idle,
         the weather call is post-hydration, the thumbnails are lazy), so a real
         preconnect would spend a handshake competing with the CSS and the fonts
         for a narrow uplink and leave the socket idle until it times out. -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.clarity.ms" />
    <link rel="dns-prefetch" href="https://api.open-meteo.com" />
    <link rel="dns-prefetch" href="https://items.templately.com" />

    <link rel="preload" as="image" href="/sky/sky.avif" type="image/avif" fetchpriority="high" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-inter-tight" preload />

    <!-- Both tags now load themselves on requestIdleCallback (see src/scripts/ga.ts
         and clarity.ts), so neither competes with the CSS, the fonts or the hero
         poster for the LCP window. -->
    <Analytics />
    <Clarity />
  </head>

  <body class="sky">
    <a href="#content" class="skip-link">Skip to content</a>
    <slot />

    <script>
      // SkyEngine: local time → sun arc + dawn/day/dusk/night palette.
      import { initSkyEngine } from '../scripts/sky-engine';
      initSkyEngine();
    </script>

    <script>
      // Scroll-reveal: add .in when elements enter the viewport.
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>
