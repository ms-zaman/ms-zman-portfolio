---
/**
 * HarbourLayout — the Night Harbour shell for the homepage.
 * The blog/404 use the sibling BlogLayout on the same tokens, so the whole
 * site is the harbour at night. Carries the icon sprite and the one entrance
 * (`.rise`) observer.
 */
import { Font } from 'astro:assets';
import Analytics from '../components/Analytics.astro';
import Clarity from '../components/Clarity.astro';
import Sprite from '../components/harbour/Sprite.astro';
// CUBE CSS layer order (see src/styles/CUBE-CSS.md): tokens/axioms → composition → utility.
// Utility loads last so it wins among the global sheets; component <style> Blocks
// (Astro-scoped, higher specificity) still override both.
import '../styles/sky-tokens.css';
import '../styles/sky-base.css';
import '../styles/sky-composition.css';
import '../styles/sky-utilities.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Keep this page out of search indexes (e.g. the internal styleguide). */
  noindex?: boolean;
}

const {
  title = 'Sharfuzzaman · WordPress Developer | WooCommerce, Plugins & MCP',
  description = 'WordPress developer who builds and ships products: WooCommerce stores, WordPress.org plugins and MCP integrations for AI assistants. 5+ years in production.',
  image = '/og.jpg',
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://sharfuzzaman.com');
const canonical = new URL(Astro.url.pathname, site).href;
// Only the homepage has a markdown twin (src/pages/index.md.ts) — the styleguide
// that also uses this layout has none, so it must not advertise one.
const markdownHref = Astro.url.pathname === '/' ? new URL('/index.md', site).href : null;
const ogImage = new URL(image, site).href;

// Structured data — Person + WebSite (helps search engines model the site owner).
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.origin}/#person`,
      name: 'Sharfuzzaman',
      alternateName: 'MS Zaman',
      url: site.origin,
      image: ogImage,
      jobTitle: 'WordPress Developer',
      description,
      sameAs: ['https://github.com/ms-zaman', 'https://www.linkedin.com/in/sharfuzzaman/'],
      knowsAbout: [
        'WordPress',
        'WooCommerce',
        'WordPress Plugin Development',
        'Model Context Protocol (MCP)',
        'PHP',
        'Elementor',
        'Gutenberg',
        'WordPress Block Themes',
        'Web Performance',
        'Astro',
        'React',
      ],
      worksFor: { '@type': 'Organization', name: 'Startise' },
      seeks: {
        '@type': 'Demand',
        name: 'Remote WordPress developer role or a well defined project',
      },
      address: { '@type': 'PostalAddress', addressLocality: 'Dhaka', addressCountry: 'BD' },
    },
    {
      '@type': 'WebSite',
      '@id': `${site.origin}/#website`,
      name: 'Sharfuzzaman',
      url: site.origin,
      author: { '@id': `${site.origin}/#person` },
      inLanguage: 'en',
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Sharfuzzaman" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#03060b" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sharfuzzaman" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sharfuzzaman, WordPress developer: I build products for the web and ship them." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Agent discovery: the markdown twin of this page, and the API catalog
         describing every machine-readable endpoint. Mirrored as a Link response
         header in netlify.toml for clients that never parse the HTML. -->
    {markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} />}
    <link rel="api-catalog" href="/.well-known/api-catalog" />
    <link rel="describedby" type="text/plain" href="/llms.txt" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline></script>

    <!-- Warm the two analytics origins; DNS only, since both tags wait for idle. -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.clarity.ms" />

    <!-- The poster is the hero's first paint (and all a GPU-less visitor sees). -->
    <link rel="preload" as="image" href="/harbour/sea-wide.avif" type="image/avif" media="(min-aspect-ratio: 1/1)" fetchpriority="high" />
    <link rel="preload" as="image" href="/harbour/sea-tall.avif" type="image/avif" media="(max-aspect-ratio: 1/1)" fetchpriority="high" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jost" preload />
    <Font cssVariable="--font-overpass-mono" />

    <!-- Both tags now load themselves on requestIdleCallback (see src/scripts/ga.ts
         and clarity.ts), so neither competes with the CSS, the fonts or the hero
         poster for the LCP window. -->
    <Analytics />
    <Clarity />
  </head>

  <body class="sky">
    <a href="#content" class="skip-link">Skip to content</a>
    <Sprite />
    <slot />

    <script>
      // One entrance: sections light up as they surface. Content is visible
      // without JS (the hidden state needs html.js) and under reduced motion.
      const els = document.querySelectorAll('.rise');
      if ('IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>
