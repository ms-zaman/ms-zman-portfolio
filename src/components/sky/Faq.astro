---
/**
 * Faq — native <details> accordion with a JS-driven grid-rows animation so it
 * expands/collapses smoothly in both directions (the `.exp` class does the work).
 * Ported from the frozen prototype (redesign/variant-g §FAQ, #faq).
 *
 * Rewritten for a recruiter/hiring audience rather than a client one — the
 * questions are the ones that come up in a first screening call. Every answer
 * is factual; nothing here states a salary, a notice period, or an availability
 * date that has not actually been agreed.
 */
import SectionHead from './SectionHead.astro';

const faqs = [
  {
    q: 'What kind of role are you looking for?',
    a: 'A remote WordPress / Web Developer role, full-time. My day-to-day is production WordPress (Elementor and Gutenberg), and that is the work I want to keep doing on a product or agency team.',
  },
  {
    q: 'Elementor or Gutenberg: which do you actually use?',
    a: 'Both, at roughly a 50/50 split across the 40+ template packs I have developed. I am equally comfortable being handed either, and comfortable saying which one fits a given build better.',
  },
  {
    q: 'What does "pixel-perfect" mean in your workflow?',
    a: 'I implement from the design reference rather than designing it myself, then work directly with the designer and QA through review rounds until the build matches at every breakpoint. Design → development → responsive implementation → QA → refinement.',
  },
  {
    q: 'What is your experience with Templately Global Style & Typography?',
    a: 'Expert-level, and it is the area I am the internal reference for on my team: implementing and maintaining Global Style and Typography systems consistently across template packs.',
  },
  {
    q: 'How do you work across time zones?',
    a: 'I am based in Dhaka (GMT+6) and I overlap comfortably with EU mornings and early US hours. My current work is already collaborative across designers, QA, and a 4-member development team I coordinate.',
  },
  {
    q: 'What else do you work with beyond WordPress?',
    a: 'HTML, CSS, JavaScript and React on the frontend; PHP and MySQL on the back; Git and GitHub day to day. I also build internal automation, and I am contributing to production WordPress-to-Astro migrations.',
  },
];
---
<section class="[ region ] [ border-top-line ]" id="faq">
  <div class="[ wrapper ]">
    <SectionHead
      eyebrow="FAQ"
      title="Good questions"
      sub="The things a hiring team usually wants to know first."
    />
    <div class="faq reveal">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}<span class="pl"></span></summary>
          <div class="faq-a"><div class="faq-ain"><p>{f.a}</p></div></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { max-width: 760px; margin: 8px auto 0; }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 4px;
    font-family: var(--display);
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -.01em;
    color: var(--ink);
    transition: color .2s;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq details:not(.exp) summary { color: var(--ink-2); }
  .faq details:not(.exp):hover summary { color: var(--accent); }

  /* plus/minus toggle */
  .faq summary .pl { flex: none; width: 22px; height: 22px; position: relative; transition: transform .25s; }
  .faq summary .pl::before,
  .faq summary .pl::after { content: ""; position: absolute; background: var(--accent); border-radius: 2px; }
  .faq summary .pl::before { left: 0; right: 0; top: 10px; height: 2px; }
  .faq summary .pl::after { top: 0; bottom: 0; left: 10px; width: 2px; transition: opacity .25s; }
  .faq details.exp summary .pl::after { opacity: 0; }

  /* animated body */
  .faq-a {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows .36s cubic-bezier(.4, 0, .2, 1), opacity .28s ease;
  }
  .faq-ain { overflow: hidden; min-height: 0; }
  .faq details.exp .faq-a { grid-template-rows: 1fr; opacity: 1; }
  /* Open state is already signalled three ways — the summary colour, the
     plus folding to a minus, and this tinted rounded row. A fourth cue (a
     3px accent bar down the left edge) was redundant, and nothing else in
     the system uses a coloured edge bar; see DESIGN.md § Elevation & Depth. */
  .faq details.exp {
    background: #f6faff;
    border: 1px solid #e1edfa;
    border-radius: 12px;
    overflow: hidden;
    margin: 6px 0;
    padding: 0 16px;
  }
  .faq p { font-size: 15px; color: var(--ink-2); line-height: 1.65; padding: 0 4px 22px; max-width: 66ch; margin: 0; }
</style>

<script>
  // Animate expand/collapse in both directions via the `.exp` class.
  document.querySelectorAll('.faq details').forEach((d) => {
    const sum = d.querySelector('summary');
    sum?.addEventListener('click', (e) => {
      e.preventDefault();
      if (d.classList.contains('exp')) {
        // closing — wait for the row animation, then actually close
        d.classList.remove('exp');
        const a = d.querySelector('.faq-a');
        const onEnd = (ev: Event) => {
          if ((ev as TransitionEvent).propertyName !== 'grid-template-rows') return;
          a?.removeEventListener('transitionend', onEnd);
          (d as HTMLDetailsElement).open = false;
        };
        a?.addEventListener('transitionend', onEnd);
      } else {
        // opening — open first, then add the class on the next frame to transition
        (d as HTMLDetailsElement).open = true;
        requestAnimationFrame(() => d.classList.add('exp'));
      }
    });
  });
</script>
