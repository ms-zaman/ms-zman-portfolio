---
/**
 * Faq — native <details> accordion with a JS-driven grid-rows animation so it
 * expands/collapses smoothly in both directions (the `.exp` class does the work).
 * Ported from the frozen prototype (redesign/variant-g §FAQ, #faq).
 *
 * Written for both a hiring manager and a client: the questions that come up
 * in a first call. Every answer is factual; nothing here states a salary, a
 * notice period, a rate, or an availability date that has not been agreed.
 */
import SectionHead from './SectionHead.astro';

const faqs = [
  {
    q: 'What kind of work are you looking for?',
    a: 'A remote role on a product or agency team, or a well defined project. Either way, work that ends up live: I am at my best taking something from the design file to production.',
  },
  {
    q: 'You do a lot of things. What are you best at?',
    a: 'WordPress and WooCommerce, end to end: the store or site, the plugins behind it, and getting it deployed and kept healthy. Everything else on this page, from Astro themes to Rust, grew out of that or feeds back into it.',
  },
  {
    q: 'Can you work inside an existing team and codebase?',
    a: 'Most of my work is exactly that. On SchedulePress I work with QA, a project manager and code reviewers through full release cycles, and on WPDeveloper’s live sites I change pages other people edit too, with a backup before every write.',
  },
  {
    q: 'What happens after launch?',
    a: 'I stay on it. After Hermizon went live, its owners ran a full audit; I shipped the fixes in 30 small batches over one week, each one recorded and checked on the live store.',
  },
  {
    q: 'Elementor or Gutenberg?',
    a: 'Both, at roughly a 50/50 split across the 40+ template packs I have developed, and custom block themes when a page builder is the wrong tool.',
  },
  {
    q: 'How do you work across time zones?',
    a: 'I am based in Dhaka (GMT+6) and I overlap comfortably with EU mornings and early US hours. My current work is already collaborative across designers, QA, a project manager and a 4-member development team I coordinate.',
  },
];

// The same array feeds the visible accordion and the FAQPage structured data,
// so the two can never drift apart.
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<section class="[ region ] [ border-top-line ]" id="faq">
  <div class="[ wrapper ]">
    <SectionHead
      eyebrow="FAQ"
      title="Good questions"
      sub="The things a hiring team usually wants to know first."
    />
    <div class="faq reveal">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}<span class="pl"></span></summary>
          <div class="faq-a"><div class="faq-ain"><p>{f.a}</p></div></div>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline></script>
</section>

<style>
  .faq { max-width: 760px; margin: 8px auto 0; }
  /* The transparent border and radius live on the base state so the open-state
     chrome (tint, border, margin, indent) can transition instead of snapping;
     the timing matches the grid-rows animation below. */
  .faq details {
    border: 1px solid transparent;
    border-bottom-color: var(--line);
    border-radius: 12px;
    transition:
      background-color .36s cubic-bezier(.4, 0, .2, 1),
      border-color .36s cubic-bezier(.4, 0, .2, 1),
      margin .36s cubic-bezier(.4, 0, .2, 1),
      padding .36s cubic-bezier(.4, 0, .2, 1);
  }
  .faq summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 4px;
    font-family: var(--display);
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -.01em;
    color: var(--ink);
    transition: color .2s;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq details:not(.exp) summary { color: var(--ink-2); }
  .faq details:not(.exp):hover summary { color: var(--accent); }

  /* plus/minus toggle — the vertical bar folds 90° down onto the horizontal
     one while fading, so the plus visibly becomes the minus. */
  .faq summary .pl { flex: none; width: 22px; height: 22px; position: relative; }
  .faq summary .pl::before,
  .faq summary .pl::after { content: ""; position: absolute; background: var(--accent); border-radius: 2px; }
  .faq summary .pl::before { left: 0; right: 0; top: 10px; height: 2px; }
  .faq summary .pl::after {
    top: 0; bottom: 0; left: 10px; width: 2px;
    transition: transform .25s cubic-bezier(.4, 0, .2, 1), opacity .25s ease;
  }
  .faq details.exp summary .pl::after { transform: rotate(90deg); opacity: 0; }

  /* animated body */
  .faq-a {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows .36s cubic-bezier(.4, 0, .2, 1), opacity .28s ease;
  }
  .faq-ain { overflow: hidden; min-height: 0; }
  .faq details.exp .faq-a { grid-template-rows: 1fr; opacity: 1; }
  /* Open state is already signalled three ways — the summary colour, the
     plus folding to a minus, and this tinted rounded row. A fourth cue (a
     3px accent bar down the left edge) was redundant, and nothing else in
     the system uses a coloured edge bar; see DESIGN.md § Elevation & Depth. */
  .faq details.exp {
    background: #f6faff;
    border-color: #e1edfa;
    overflow: hidden;
    margin: 6px 0;
    padding: 0 16px;
  }
  .faq p { font-size: 15px; color: var(--ink-2); line-height: 1.65; padding: 0 4px 22px; max-width: 66ch; margin: 0; }

  @media (prefers-reduced-motion: reduce) {
    .faq details,
    .faq-a,
    .faq summary .pl::after { transition: none; }
  }
</style>

<script>
  // Animate expand/collapse in both directions via the `.exp` class. The class
  // is what animates; `open` is the source of truth, and a pending close must
  // be cancelled on reopen or its transitionend fires after the reopen
  // transition and closes the details underneath the open styling.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll('.faq details').forEach((el) => {
    const d = el as HTMLDetailsElement;
    const a = d.querySelector('.faq-a');
    let closing: ((ev: Event) => void) | null = null;
    const cancelClose = () => {
      if (closing) {
        a?.removeEventListener('transitionend', closing);
        closing = null;
      }
    };
    // A browser-initiated open (find-in-page auto-expand) sets `open` without a
    // click; sync the class so the answer is actually visible.
    d.addEventListener('toggle', () => {
      if (d.open && !d.classList.contains('exp')) {
        requestAnimationFrame(() => d.classList.add('exp'));
      }
    });
    d.querySelector('summary')?.addEventListener('click', (e) => {
      e.preventDefault();
      if (d.classList.contains('exp')) {
        // closing — wait for the row animation, then actually close
        d.classList.remove('exp');
        if (reduceMotion.matches) {
          // transitions are off, so no transitionend would ever arrive
          d.open = false;
          return;
        }
        closing = (ev: Event) => {
          if ((ev as TransitionEvent).propertyName !== 'grid-template-rows') return;
          cancelClose();
          if (!d.classList.contains('exp')) d.open = false;
        };
        a?.addEventListener('transitionend', closing);
      } else {
        // opening — open first, then add the class on the next frame to
        // transition. On a reopen mid-close `open` is still true and no toggle
        // fires, so the class is added here rather than left to the handler.
        cancelClose();
        d.open = true;
        requestAnimationFrame(() => d.classList.add('exp'));
      }
    });
  });
</script>
