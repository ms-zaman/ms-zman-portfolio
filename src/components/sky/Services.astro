---
/**
 * Services — six capability cards ("what I bring to a team").
 * Ported from the frozen prototype (redesign/variant-g §Services, #services) and
 * re-pointed at WordPress: the cards now describe production capability rather
 * than freelance packages, since the site targets remote WordPress roles.
 * Data-driven; each `icon` is the inner markup of a 24x24 stroked SVG and each
 * `body` may contain <b> emphasis, so both are rendered with set:html.
 * NOTE: `.svc-start` mirrors the prototype as static text (not a link).
 */
import SectionHead from './SectionHead.astro';

interface Service {
  title: string;
  icon: string;
  body: string;
  features: string[];
  note: string;
}

const services: Service[] = [
  {
    title: 'Elementor development',
    icon: '<path d="M4 4h16v16H4z"/><path d="M8 8h3v8H8z"/><path d="M14 8h2v3h-2z"/><path d="M14 13h2v3h-2z"/>',
    body: 'Production template packs and client-editable sites built in <b>Elementor</b> – custom layouts, responsive breakpoints, and structure that survives real content.',
    features: ['Multi-page template packs', 'Responsive at every breakpoint', 'Built for client editing'],
    note: 'Roughly half my build work',
  },
  {
    title: 'Gutenberg development',
    icon: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>',
    body: 'Native <b>block editor</b> builds – block patterns, reusable layouts, and clean semantic structure that stays fast without a page-builder runtime.',
    features: ['Native block patterns', 'Accessible, semantic markup', 'No builder overhead'],
    note: 'The other half',
  },
  {
    title: 'Pixel-perfect implementation',
    icon: '<path d="M12 3v3"/><path d="M12 18v3"/><path d="M3 12h3"/><path d="M18 12h3"/><circle cx="12" cy="12" r="4"/>',
    body: 'I translate design specifications into production-ready builds – working directly with designers and QA until the implementation matches the reference at every breakpoint.',
    features: ['Figma → WordPress', 'Designer & QA collaboration', 'Refined until it matches'],
    note: 'Core of the workflow',
  },
  {
    title: 'Global Style & Typography',
    icon: '<path d="M4 20h16"/><path d="M6 16 12 4l6 12"/><path d="M8.5 12h7"/>',
    body: 'Expert-level experience implementing and maintaining <b>Templately’s Global Style and Typography</b> systems across template packs – the internal reference for it on my team.',
    features: ['Global Style & Typography systems', 'Consistency across packs', 'Recognised internally'],
    note: 'Specialist area',
  },
  {
    title: 'WooCommerce & production WordPress',
    icon: '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>',
    body: 'Store and site work on live installs – <b>WooCommerce</b> layouts, theme customisation, plus the update and maintenance workflows that keep a site ecosystem healthy.',
    features: ['WooCommerce layouts', 'Theme & template customisation', 'Update & maintenance workflows'],
    note: 'Live production sites',
  },
  {
    title: 'Frontend, migration & automation',
    icon: '<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>',
    body: 'Hand-written <b>HTML, CSS, JavaScript</b> and <b>React</b> where a builder is the wrong tool – plus WordPress migrations, WordPress-to-Astro work, and automating repetitive maintenance.',
    features: ['JavaScript & React', 'WordPress → Astro migration', 'Automation of repeat work'],
    note: 'Where I keep growing',
  },
];

/* Toolkit — the flat skills list a recruiter scans for keywords, ordered so
   WordPress reads first. Kept as one compact block under the capability cards
   rather than its own section, so it adds no nav weight. */
const toolkit: { group: string; items: string[] }[] = [
  { group: 'WordPress', items: ['WordPress', 'Elementor', 'Gutenberg', 'WooCommerce', 'Theme development', 'Template development', 'Global Style & Typography'] },
  { group: 'Frontend', items: ['HTML5', 'CSS3', 'JavaScript', 'React', 'Responsive development', 'Pixel-perfect UI implementation', 'Figma → WordPress'] },
  { group: 'Development', items: ['PHP', 'MySQL', 'Git', 'GitHub'] },
  { group: 'Additional', items: ['On-page SEO-aware development', 'WordPress migration', 'WordPress → Astro', 'AI-assisted automation'] },
];
---
<section class="[ region ] [ border-top-line ]" id="services">
  <div class="[ wrapper ]">
    <SectionHead
      eyebrow="Expertise"
      title="What I bring to a team"
      sub="Five-plus years of production WordPress – built around Elementor and Gutenberg, and around getting an implementation to match its design exactly."
    />

    <div class="[ svc-grid ] [ grid ]">
      {services.map((s) => (
        <article class="[ svc ] [ bg-card ] [ reveal ]">
          <span class="[ svc-ic ] [ bg-accent-soft text-accent ]">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
          </span>
          <h3>{s.title}</h3>
          <p set:html={s.body} />
          <div class="svc-list">
            {s.features.map((f) => <div><span class="ck">✓</span> {f}</div>)}
          </div>
          <span class="svc-start">{s.note}</span>
        </article>
      ))}
    </div>

    <div class="[ toolkit ] [ reveal ]">
      {toolkit.map((t) => (
        <div class="[ tk-row ] [ grid ]">
          <div class="tk-group">{t.group}</div>
          <div class="[ tk-items ] [ cluster ]">{t.items.map((i) => <span>{i}</span>)}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Block = card visual treatment. Grid layout comes from .grid (markup),
     the section divider from .border-top-line, and surface/accent colour from
     the .bg-card / .bg-accent-soft / .text-accent utilities. */
  .svc-grid {
    --grid-space: 22px;             /* .grid gutter (was gap: 22px) */
    grid-template-columns: repeat(3, 1fr);
    margin-top: 8px;
  }
  .svc {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 26px 24px;
    box-shadow: var(--shadow-sm);   /* was the identical literal — now the token */
    transition: transform .25s, border-color .25s, box-shadow .25s;
  }
  .svc:hover {
    transform: translateY(-4px);
    border-color: #bcd7f2;
    box-shadow: 0 20px 46px rgba(40, 80, 140, .12);
  }
  .svc-ic {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    margin-bottom: 16px;
  }
  .svc-ic svg { width: 22px; height: 22px; }
  .svc h3 {
    font-family: var(--display);
    font-weight: 600;
    font-size: 19px;
    letter-spacing: -.01em;
    margin-bottom: 9px;
  }
  .svc p { font-size: 14.5px; color: var(--ink-2); line-height: 1.6; }
  .svc p :global(b) { color: var(--ink); font-weight: 600; }

  .svc-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 14px 0 18px;
  }
  .svc-list div {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 13.5px;
    color: var(--ink-2);
  }
  .svc-list .ck { color: var(--accent); font-weight: 700; }

  /* was the card CTA ("Start a project →"); now a quiet footnote label, so it
     reads as context rather than an unclickable button */
  .svc-start {
    margin-top: auto;
    padding-top: 16px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--ink-3);
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  /* Toolkit — label column + tag cluster per row, on the section's own rhythm */
  .toolkit { margin-top: 44px; }
  .tk-row {
    --grid-space: 10px 24px;
    grid-template-columns: 160px 1fr;
    align-items: baseline;
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }
  .tk-group {
    font-size: 12px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase;
    color: var(--ink-3);
  }
  .tk-items { --cluster-space: 8px; }
  .tk-items span {
    font-size: 13px; color: var(--ink-2);
    background: #f2f6fb; padding: 6px 12px; border-radius: 8px;
  }
  /* WordPress is the headline category — give its tags the accent surface */
  .tk-row:first-child .tk-items span { background: var(--accent-soft); color: var(--accent); font-weight: 500; }

  @media (max-width: 900px) { .svc-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) {
    .svc-grid { grid-template-columns: 1fr; }
    .tk-row { grid-template-columns: 1fr; }
  }
</style>
