/* Toolkit — the flat skills list a recruiter scans for keywords, ordered so
   WordPress reads first. Kept as one compact block under the capability cards
   rather than its own section, so it adds no nav weight. */
const toolkit: { group: string; items: string[] }[] = [
  { group: 'WordPress', items: ['WordPress', 'WooCommerce', 'Elementor', 'Gutenberg', 'Block themes', 'Plugin development', 'Global Style & Typography'] },
  { group: 'Backend', items: ['PHP', 'MySQL', 'REST API', 'WP CLI', 'Composer', 'PHPStan', 'MCP', 'OAuth'] },
  { group: 'Frontend', items: ['HTML', 'CSS', 'JavaScript', 'React', 'Astro', 'WebGL (React Three Fiber)', 'Figma to code'] },
  { group: 'Ship', items: ['Git', 'GitHub Actions', 'Netlify', 'Cloudflare', 'xCloud', 'WordPress.org SVN'] },
  { group: 'Also', items: ['Python', 'Rust (learning)', 'SEO aware development', 'WordPress to Astro'] },
];
---
<section class="[ region ] [ border-top-line ]" id="services">
  <div class="[ wrapper ]">
    <SectionHead
      eyebrow="Expertise"
      title="What I bring to a team"
      sub="Over five years of production WordPress, and everything it takes to get a product live: the store, the plugins, the AI tools, the deploy."
    />

    <div class="[ svc-grid ] [ grid ]">
      {services.map((s) => (
        <article class="[ svc ] [ bg-card ] [ reveal ]">
          <span class="svc-ic" aria-hidden="true" set:html={s.icon} />
          <h3>{s.title}</h3>
          <p set:html={s.body} />
          <div class="svc-list">
            {s.features.map((f) => <div><span class="ck">✓</span> {f}</div>)}
          </div>
          <span class="svc-start">{s.note}</span>
        </article>
      ))}
    </div>

    <div class="[ toolkit ] [ reveal ]">
      {toolkit.map((t) => (
        <div class="[ tk-row ] [ grid ]">
          <div class="tk-group">{t.group}</div>
          <div class="[ tk-items ] [ cluster ]">{t.items.map((i) => <span>{i}</span>)}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Block = card visual treatment. Grid layout comes from .grid (markup),
     the section divider from .border-top-line, and surface/accent colour from
     the .bg-card / .bg-accent-soft / .text-accent utilities. */
  .svc-grid {
    --grid-space: 22px;             /* .grid gutter (was gap: 22px) */
    grid-template-columns: repeat(3, 1fr);
    margin-top: 8px;
  }
  .svc {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 26px 24px;
    box-shadow: var(--shadow-sm);   /* was the identical literal — now the token */
    transition: transform .25s, border-color .25s, box-shadow .25s;
  }
  .svc:hover {
    transform: translateY(-4px);
    border-color: #bcd7f2;
    box-shadow: 0 20px 46px rgba(40, 80, 140, .12);
  }
  .svc-ic {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    margin-bottom: 16px;
    /* neutral chip so each brand's real colour reads true (was accent-soft) */
    background: #f3f7fb;
    border: 1px solid var(--line);
  }
  .svc-ic svg { display: block; }
  /* concept icons (plugin, MCP, deploy, speed) are line art in the accent; brand
     marks carry their own fills, so currentColor never reaches them */
  .svc-ic { color: var(--accent); }
  /* the Elementor & Gutenberg card shows both marks side by side */
  .svc-ic :global(.svc-pair) { display: inline-flex; align-items: center; gap: 3px; }
  .svc-ic :global(.svc-pair img) { width: 20px; height: 20px; }
  /* the Gutenberg card uses the project's raster emblem instead of an inline mark */
  .svc-ic img { width: 30px; height: 30px; object-fit: contain; display: block; }
  .svc h3 {
    font-family: var(--display);
    font-weight: 600;
    font-size: 19px;
    letter-spacing: -.01em;
    margin-bottom: 9px;
  }
  .svc p { font-size: 14.5px; color: var(--ink-2); line-height: 1.6; }
  .svc p :global(b) { color: var(--ink); font-weight: 600; }

  .svc-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 14px 0 18px;
  }
  .svc-list div {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 13.5px;
    color: var(--ink-2);
  }
  .svc-list .ck { color: var(--accent); font-weight: 700; }

  /* was the card CTA ("Start a project →"); now a quiet footnote label, so it
     reads as context rather than an unclickable button */
  .svc-start {
    margin-top: auto;
    padding-top: 16px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--ink-3);
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  /* Toolkit — label column + tag cluster per row, on the section's own rhythm */
  .toolkit { margin-top: 44px; }
  .tk-row {
    --grid-space: 10px 24px;
    grid-template-columns: 160px 1fr;
    align-items: baseline;
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }
  .tk-group {
    font-size: 12px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase;
    color: var(--ink-3);
  }
  .tk-items { --cluster-space: 8px; }
  .tk-items span {
    font-size: 13px; color: var(--ink-2);
    background: #f2f6fb; padding: 6px 12px; border-radius: 8px;
  }
  /* WordPress is the headline category — give its tags the accent surface */
  .tk-row:first-child .tk-items span { background: var(--accent-soft); color: var(--accent); font-weight: 500; }

  @media (max-width: 900px) { .svc-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) {
    .svc-grid { grid-template-columns: 1fr; }
    .tk-row { grid-template-columns: 1fr; }
  }
</style>
