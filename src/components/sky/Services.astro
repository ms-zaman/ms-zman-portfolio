---
/**
 * Services — six capability cards ("what I bring to a team").
 * Ported from the frozen prototype (redesign/variant-g §Services, #services) and
 * re-pointed (2026-11) from "Elementor & Gutenberg specialist" to the whole job
 * of shipping a WordPress product; each card's note names the work that proves it.
 * Data-driven; each `icon` is a self-contained SVG (brand marks keep their real
 * colours; concept marks are accent line art via currentColor), and each `body`
 * may contain <b> emphasis, so both are rendered with set:html.
 * NOTE: `.svc-start` mirrors the prototype as static text (not a link).
 */
import SectionHead from './SectionHead.astro';

interface Service {
  title: string;
  icon: string;
  body: string;
  features: string[];
  note: string;
}

