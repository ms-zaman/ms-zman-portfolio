---
/**
 * SelectedWork — four case studies (live products), each shown as a
 * sticky text column beside a horizontally-scrolling rail of screenshots
 * (layout borrowed from northgarden.com/work, restyled with Sky tokens).
 * Followed by "Also built" cards and the Templately library list.
 *
 * Screenshots are captures of the live sites in public/work/ (Playwright,
 * 2026-11-26) plus ShopCurator's own WordPress.org screenshots. Every metric
 * is sourced in redesign/case-studies-draft.md; do not add one without a source.
 * The rail is a keyboard-scrollable group rather than a list of links, so the
 * row keeps exactly one destination (the product link) and no nested anchors.
 */
import SectionHead from './SectionHead.astro';

interface Shot {
  label: string;
  src: string;
  w: number;
  h: number;
}

interface Work {
  href: string;
  linkLabel: string;
  num: string;
  tags: string[];
  name: string;
  sub: string;
  desc: string;
  metrics: { b: string; s: string }[];
  rail: Shot[];
}

/* Portrait captures are 900x1030 (a 450px phone or a 1200px desktop, both
   scaled to the rail's tile); ShopCurator's are its WordPress.org screenshots. */
const P = { w: 900, h: 1030 };
const L = { w: 1280, h: 900 };

const works: Work[] = [
  {
    href: 'https://hermizon.com/',
    linkLabel: 'Visit hermizon.com',
    num: '01',
    tags: ['Client project', 'WooCommerce'],
    name: 'Hermizon',
    sub: 'Women’s footwear store, Bangladesh',
    desc: 'I rebuilt the store on a custom block theme and six plugins of my own (phone sign in with SMS codes, courier booking, server side tracking), deployed it, and run it. The shop’s team manages it through an AI assistant that previews every change and waits for a confirm before it touches the live store.',
    metrics: [{ b: '80%', s: 'lighter home page' }, { b: '1.36s', s: 'LCP, real users' }, { b: '34', s: 'MCP tools' }],
    rail: [
      { label: 'Home', src: '/work/hermizon/home.webp', ...P },
      { label: 'Product cards', src: '/work/hermizon/home-cards.webp', ...P },
      { label: 'Shop', src: '/work/hermizon/shop.webp', ...P },
      { label: 'Product', src: '/work/hermizon/product.webp', ...P },
      { label: 'Size and delivery', src: '/work/hermizon/product-buy.webp', ...P },
      { label: 'Bridal collection', src: '/work/hermizon/bridal.webp', ...P },
    ],
  },
  {
    href: 'https://wordpress.org/plugins/shopcurator/',
    linkLabel: 'View on WordPress.org',
    num: '02',
    tags: ['Own plugin', 'WordPress.org'],
    name: 'ShopCurator',
    sub: 'Free WooCommerce plugin for block themes',
    desc: 'The fixes I wrote for one store solved problems every block theme shop has, so I rebuilt them as a plugin anyone can install: storefront blocks, a My Account area customers can actually use, size filters that only count what is in stock, and phone sign in with SMS codes.',
    metrics: [{ b: '22', s: 'storefront blocks' }, { b: 'Nov 2026', s: 'approved on WordPress.org' }, { b: 'Free', s: 'GPL' }],
    rail: [
      { label: 'WordPress.org', src: '/work/shopcurator/wporg.webp', ...P },
      { label: 'Search overlay', src: '/work/shopcurator/search.webp', ...L },
      { label: 'Quick view', src: '/work/shopcurator/quick-view.webp', ...L },
      { label: 'Review summary', src: '/work/shopcurator/reviews.webp', ...L },
      { label: 'My Account', src: '/work/shopcurator/account.webp', w: 1280, h: 1465 },
    ],
  },
  {
    href: 'https://wordpress.org/plugins/wp-scheduled-posts/',
    linkLabel: 'View on WordPress.org',
    num: '03',
    tags: ['WPDeveloper', 'MCP'],
    name: 'SchedulePress',
    sub: 'Post scheduling and social sharing plugin',
    desc: 'I took the plugin’s MCP server from an internal branch to a public release, so Claude and ChatGPT can plan and share posts, with sharing off until an admin allows it and every share confirmed. I also run the Free and Pro releases: three in three weeks in November 2026.',
    metrics: [{ b: '10K+', s: 'active installs' }, { b: '20', s: 'MCP tools' }, { b: '5.4.0', s: 'shipped 24 Nov 2026' }],
    rail: [
      { label: 'WordPress.org', src: '/work/schedulepress/wporg.webp', ...P },
      { label: 'Changelog, 5.4.0', src: '/work/schedulepress/changelog.webp', ...P },
      { label: 'schedulepress.com', src: '/work/schedulepress/features.webp', ...P },
    ],
  },
  {
    href: 'https://wpdeveloper.com/',
    linkLabel: 'Visit wpdeveloper.com',
    num: '04',
    tags: ['WPDeveloper', 'Elementor'],
    name: 'WPDeveloper sites',
    sub: 'Company homepage and Black Friday 2026',
    desc: 'Instead of hand building every page, I generate the Elementor page data from Figma in Python, push it over the REST API and check it against the design in a headless browser. It built the wpdeveloper.com homepage and the Black Friday pages across five sites, with a backup before every live write.',
    metrics: [{ b: '8 Oct', s: 'homepage live' }, { b: '5', s: 'sites for Black Friday' }, { b: 'Python', s: 'Figma to Elementor' }],
    rail: [
      { label: 'Homepage', src: '/work/wpdeveloper/home.webp', ...P },
      { label: 'Homepage, products', src: '/work/wpdeveloper/home-products.webp', ...P },
      { label: 'Deals', src: '/work/wpdeveloper/deals.webp', ...P },
      { label: 'Agency bundle', src: '/work/wpdeveloper/agency-bundle.webp', ...P },
      { label: 'Black Friday', src: '/work/wpdeveloper/black-friday.webp', ...P },
    ],
  },
];

interface Highlight {
  kind: string;
  badge?: string;
  name: string;
  href?: string;
  desc: string;
  tags: string[];
}

/* Smaller finished work: cards rather than case study rows. Kept short;
   detail belongs in a conversation, not the homepage. */
const highlights: Highlight[] = [
  {
    kind: 'Internal tool',
    badge: '1st place · Startise AI Automation Competition',
    name: 'Plugin Pilot',
    desc: 'Deploys WordPress plugins to many sites at once from a dashboard or from Slack, with site credentials encrypted at rest and Google Workspace sign in.',
    tags: ['Node', 'Slack', 'WordPress', 'Automation'],
  },
  {
    kind: 'Astro theme',
    badge: 'Official Astro themes directory',
    name: 'Saasar',
    href: 'https://astro.build/themes/details/saasar-ai-saas-project-management-astro-theme/',
    desc: 'A paid theme for AI SaaS and project management products, with 18 page templates. Built with Build2Next.',
    tags: ['Astro', 'Theme', 'SaaS'],
  },
  {
    kind: 'This site',
    name: 'A sky that scores 99',
    desc: 'The live WebGL weather above scored 42 on mobile PageSpeed. The code was fine; the test machine has no GPU. Now it scores 99, and it serves Markdown to AI agents.',
    tags: ['Astro', 'WebGL', 'Performance'],
  },
  {
    kind: 'Live',
    name: 'Prostuti',
    href: 'https://visaprep.sharfuzzaman.com/',
    desc: 'A Bengali site that helps people in Bangladesh prepare Indian visa applications, with a photo checker that runs in the browser.',
    tags: ['Astro', 'Cloudflare', 'Bengali'],
  },
];

const moreLibrary = [
  { href: 'https://templately.com/pack/saastrive-elementor-saas-template', name: 'SaaStrive', cat: 'SaaS · Elementor' },
  { href: 'https://templately.com/pack/mindxtend-business-consultancy-template-gutenberg', name: 'MindXtend', cat: 'Consultancy · Gutenberg' },
  { href: 'https://templately.com/pack/bookanair-elementor-flight-booking-website', name: 'BookAnAir', cat: 'Flight booking · Elementor' },
  { href: 'https://templately.com/pack/naturexplo-gutenberg-travel-eco-tourism-template', name: 'NaturExplo', cat: 'Travel · Gutenberg' },
  { href: 'https://templately.com/pack/flexidropper-elementor-dropshipping-agency-template', name: 'FlexiDropper', cat: 'Dropshipping · Elementor' },
  { href: 'https://templately.com/pack/snapcatch-gutenberg-photography-template', name: 'SnapCatch', cat: 'Photography · Gutenberg' },
  { href: 'https://templately.com/pack/multigency-elementor-multipurpose-template', name: 'Multigency', cat: 'Multipurpose · Elementor' },
  { href: 'https://templately.com/pack/noocodehub-gutenberg-no-code-community', name: 'NooCodeHub', cat: 'Community · Gutenberg' },
  { href: 'https://templately.com/pack/hiringfinds-elementor-job-board-template', name: 'HiringFinds', cat: 'Job board · Elementor' },
  { href: 'https://templately.com/pack/d-care-gutenberg-dentist-clinic-template', name: 'D-Care', cat: 'Dental clinic · Gutenberg' },
];
---
<section class="[ region ] [ border-top-line ]" id="work">
  <div class="[ wrapper ]">
    <SectionHead
      eyebrow="Selected work"
      title="Things I've shipped"
      sub="Four products that are live right now, from a store I run to a plugin on 10,000+ sites. Each one started with a real problem."
    />

    {works.map((w) => (
      <article class="[ work-row ] [ grid ] [ border-top-line reveal ]">
        <div class="wr-info">
          <div class="[ wr-top ] [ cluster ]">
            <span class="wr-num">{w.num}</span>
            <span class="[ wr-tags ] [ cluster ]">{w.tags.map((t) => <span>{t}</span>)}</span>
          </div>
          <h3 class="wr-name">{w.name}</h3>
          <div class="wr-sub">{w.sub}</div>
          <p class="wr-desc">{w.desc}</p>
          <div class="[ wr-metrics ] [ cluster ]">
            {w.metrics.map((m) => <div><b>{m.b}</b> <span>{m.s}</span></div>)}
          </div>
          <a class="wr-link" href={w.href} target="_blank" rel="noopener">
            <span class="wr-live" aria-hidden="true">●</span>
            {w.linkLabel} <span class="ar" aria-hidden="true">↗</span>
          </a>
        </div>

        <div
          class="wr-rail"
          tabindex="0"
          role="group"
          aria-label={`${w.name} screenshots, scroll horizontally`}
        >
          {w.rail.map((s, i) => (
            <figure class="wr-shot">
              <img
                src={s.src}
                alt={`${w.name}: ${s.label}`}
                width={s.w}
                height={s.h}
                style={`aspect-ratio: ${s.w} / ${s.h}`}
                loading="lazy"
                decoding="async"
                fetchpriority={i === 0 ? 'auto' : 'low'}
              />
              <figcaption>{s.label}</figcaption>
            </figure>
          ))}
        </div>
      </article>
    ))}

    <div class="[ hl-block ] [ border-top-line ] [ reveal ]">
      <div class="[ mt-head ] [ repel ]">
        <div class="mt-title">Also built</div>
        <div class="mt-note">Smaller, finished, and in use</div>
      </div>
      <div class="[ hl-grid ] [ grid ]">
        {highlights.map((h) => (
          <article class="[ hl-card ] [ bg-card ]">
            <div class="[ hl-top ] [ cluster ]">
              <span class="hl-kind">{h.kind}</span>
              {h.badge && <span class="hl-badge">{h.badge}</span>}
            </div>
            <h3 class="hl-name">{h.href ? <a href={h.href} target="_blank" rel="noopener">{h.name} <span class="ar" aria-hidden="true">↗</span></a> : h.name}</h3>
            <p class="hl-desc">{h.desc}</p>
            <div class="[ hl-tags ] [ cluster ]">{h.tags.map((t) => <span>{t}</span>)}</div>
          </article>
        ))}
      </div>
    </div>

    <div class="[ more-tpl ] [ border-top-line ] [ reveal ]">
      <div class="[ mt-head ] [ repel ]">
        <div class="mt-title">From the template library</div>
        <div class="mt-note">10 of the 40+ packs I have developed, all live on templately.com</div>
      </div>
      <div class="[ mt-grid ] [ grid ]">
        {moreLibrary.map((m) => (
          <a class="[ mt-row ] [ cluster ]" href={m.href} target="_blank" rel="noopener">
            <span class="mt-name">{m.name}</span>
            <span class="mt-cat">{m.cat}</span>
            <span class="mt-ar" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* distance from the wrap's content edge out to the viewport edge, so the
     rail can bleed off-screen; .sky has overflow-x:hidden so it can't add
     a horizontal scrollbar even when the scrollbar makes 100vw overshoot */
  /* Layout = .grid (sticky-col + rail columns kept here) + .border-top-line;
     the horizontal rail below is bespoke (must not wrap) and stays Block. */
  .work-row {
    --bleed: calc(max(0px, (100vw - var(--wrap)) / 2) + 40px);
    --grid-space: 44px;
    grid-template-columns: minmax(260px, 340px) 1fr;
    padding: 48px 0;
  }

  /* — left: sticky info column — */
  .wr-info {
    position: sticky;
    top: 96px;
    align-self: start;
  }
  .wr-top { --cluster-space: 12px; margin-bottom: 16px; }
  .wr-num { font-family: var(--display); font-size: 13px; color: var(--ink-3); letter-spacing: .08em; }
  .wr-tags { --cluster-space: 8px; }
  .wr-tags span {
    font-size: 12px;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 4px 11px;
    border-radius: var(--r-sm);
  }
  .wr-name {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(28px, 3.4vw, 40px);
    letter-spacing: -.025em;
    line-height: 1.05;
    margin: 0 0 6px;
  }
  .wr-sub { font-size: 15px; color: var(--ink-3); margin-bottom: 16px; }
  .wr-desc {
    font-size: 15.5px;
    color: var(--ink-2);
    line-height: 1.6;
    margin: 0 0 20px;
    max-width: 46ch;
  }
  .wr-metrics {
    --cluster-space: 8px 22px;
    padding: 13px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-bottom: 20px;
  }
  .wr-metrics b { font-family: var(--display); font-size: 17px; color: var(--ink); }
  .wr-metrics span { font-size: 12.5px; color: var(--ink-3); }
  .wr-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--accent);
  }
  .wr-live { color: #1e7a4d; font-size: 10px; }
  .wr-link .ar { transition: transform .25s; }
  .wr-link:hover .ar { transform: translate(3px, -3px); }

  /* — right: horizontal rail of page previews — */
  .wr-rail {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    /* bleed past the wrap so the rail runs off the right edge of the screen */
    margin-right: calc(-1 * var(--bleed));
    padding: 4px var(--bleed) 18px 0;
    /* keep the native scrollbar out of the way but still usable */
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }
  .wr-shot {
    flex: 0 0 auto;
    margin: 0;
    scroll-snap-align: start;
  }
  .wr-shot img {
    width: auto;
    height: clamp(260px, 34vw, 400px);
    object-fit: cover;
    object-position: top center;
    border-radius: var(--r-md);
    border: 1px solid var(--line);
    background: var(--paper);
    box-shadow: var(--shadow-sm);
    transition: transform .4s ease, box-shadow .4s ease;
  }
  .wr-shot:hover img { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .wr-shot figcaption {
    font-size: 12.5px;
    color: var(--ink-3);
    margin-top: 10px;
  }

  /* — more-from-the-library list — */
  /* More-list = .border-top-line + .repel head + .grid + .cluster rows. */
  .more-tpl { margin-top: 56px; padding-top: 36px; }
  .mt-head {
    --repel-align: baseline;
    --repel-space: 14px;
    margin-bottom: 8px;
  }
  .mt-title { font-family: var(--display); font-size: 22px; font-weight: 600; letter-spacing: -.01em; }
  .mt-note { font-size: 13.5px; color: var(--ink-3); }
  .mt-grid { --grid-space: 0 44px; grid-template-columns: 1fr 1fr; }
  .mt-row {
    --cluster-space: 12px;
    padding: 13px 0;
    border-bottom: 1px solid var(--line);
    transition: padding .2s;
  }
  .mt-row:hover { padding-left: 8px; }
  .mt-name { font-size: 15px; font-weight: 500; color: var(--ink); transition: color .2s; }
  .mt-row:hover .mt-name { color: var(--accent); }
  .mt-cat { font-size: 12.5px; color: var(--ink-3); margin-left: auto; }
  .mt-ar { color: var(--ink-3); font-size: 13px; transition: .2s; }
  .mt-row:hover .mt-ar { color: var(--accent); transform: translate(2px, -2px); }

  /* "Also built" — internal / in-progress work that has no public link, so it
     sits in cards rather than the linked rows above. Same 56/36px rhythm and
     .mt-head as the library block below it. */
  .hl-block { margin-top: 56px; padding-top: 36px; }
  .hl-grid { --grid-space: 22px; grid-template-columns: 1fr 1fr; margin-top: 20px; }
  .hl-card {
    padding: 26px 24px;
    border-radius: 18px;
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .hl-top { --cluster-space: 10px; }
  .hl-kind {
    font-size: 11px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase;
    color: var(--ink-3);
  }
  .hl-badge {
    font-size: 11.5px; font-weight: 600; line-height: 1;
    padding: 6px 10px; border-radius: 999px;
    background: var(--accent-soft); color: var(--accent);
  }
  .hl-name { font-family: var(--display); font-size: 22px; font-weight: 600; letter-spacing: -.01em; margin: 0; }
  .hl-name a { color: inherit; }
  .hl-name a .ar { font-size: .7em; color: var(--ink-3); transition: transform .25s, color .25s; display: inline-block; }
  .hl-name a:hover { color: var(--accent); }
  .hl-name a:hover .ar { color: var(--accent); transform: translate(2px, -2px); }
  .hl-desc { font-size: 14.5px; line-height: 1.6; color: var(--ink-2); margin: 0; }
  .hl-tags { --cluster-space: 7px; margin-top: auto; padding-top: 6px; }
  .hl-tags span {
    font-size: 12px; color: var(--ink-3);
    padding: 5px 10px; border-radius: 999px; border: 1px solid var(--line);
  }

  @media (max-width: 900px) {
    .hl-grid { grid-template-columns: 1fr; }
    /* stack: info on top, rail below — no sticky, it fights a short column */
    .work-row { grid-template-columns: 1fr; --grid-space: 24px; padding: 38px 0; }
    .wr-info { position: static; }
    .wr-desc { max-width: none; }
  }
  @media (max-width: 680px) {
    .work-row { --bleed: 22px; }
    .mt-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wr-rail { scroll-snap-type: none; }
    .wr-shot img { transition: none; }
    .wr-shot:hover img { transform: none; }
  }
</style>
