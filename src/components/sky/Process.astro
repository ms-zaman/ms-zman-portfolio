---
/**
 * Process — "How I ship": the four steps the work actually follows (written
 * decision records, checking the real path, release gates), taken from how
 * Hermizon and the SchedulePress releases are run.
 * Ported from the frozen prototype (redesign/variant-g §Process, #process).
 */
import SectionHead from './SectionHead.astro';

const steps = [
  { n: '1', title: 'Understand', body: 'Read the brief, the design and the data before writing code, and ask about what is unclear while it is still cheap to change.' },
  { n: '2', title: 'Decide, in writing', body: 'Every real choice gets a short written record: what, why, and what else was considered. Anyone can see the reasoning later, including me.' },
  { n: '3', title: 'Check the real path', body: 'Tests are a start. I also check the thing a user actually touches, on a real install, because a passing test can still hide a broken feature.' },
  { n: '4', title: 'Release behind a gate', body: 'Staging first, a checklist, a rollback ready. If a check fails, it does not ship.' },
];
---
<section class="[ region ] [ border-top-line ]" id="process">
  <div class="[ wrapper ]">
    <SectionHead
      eyebrow="How I work"
      title="How I ship"
      sub="The same four steps whether it is a template, a plugin release or a whole store. The last one decides whether it goes out."
    />
    <div class="[ proc-grid ] [ grid ]">
      {steps.map((s) => (
        <div class="proc reveal">
          <div class="[ proc-n ] [ bg-accent-soft text-accent ]">{s.n}</div>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Layout = .grid (markup) + border-top-line; accent chip colour = utilities. */
  .proc-grid { --grid-space: 22px; grid-template-columns: repeat(4, 1fr); margin-top: 8px; }
  .proc { padding: 26px 22px; border-radius: 18px; border: 1px solid var(--line); background: var(--paper); }
  .proc-n {
    font-family: var(--display);
    font-weight: 600;
    font-size: 15px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    margin-bottom: 16px;
  }
  .proc h3 { font-family: var(--display); font-weight: 600; font-size: 18px; letter-spacing: -.01em; margin-bottom: 8px; }
  .proc p { font-size: 14px; color: var(--ink-2); line-height: 1.55; }

  @media (max-width: 820px) { .proc-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .proc-grid { grid-template-columns: 1fr; } }
</style>
