---
/**
 * Process — the four-stage build workflow behind a pixel perfect implementation.
 * Ported from the frozen prototype (redesign/variant-g §Process, #process) and
 * re-pointed from a client-project flow to how the work actually runs on a team.
 */
import SectionHead from './SectionHead.astro';

const steps = [
  { n: '1', title: 'Design', body: 'I start from the design reference (Figma files or a spec from the design team) and read it closely enough to catch what is ambiguous before building anything.' },
  { n: '2', title: 'Development', body: 'The build itself, in Elementor or Gutenberg: real structure, reusable patterns, and content that stays editable by whoever inherits it.' },
  { n: '3', title: 'Responsive', body: 'Every breakpoint handled deliberately rather than left to the builder’s defaults, so the layout holds from wide desktop down to small phones.' },
  { n: '4', title: 'QA & refinement', body: 'QA reviews the build, I work with them and the designer through the findings, and refine until the implementation matches the design.' },
];
---
<section class="[ region ] [ border-top-line ]" id="process">
  <div class="[ wrapper ]">
    <SectionHead
      eyebrow="How I work"
      title="What pixel perfect actually takes"
      sub="Design → development → responsive implementation → QA → refinement. The last stage is the one that decides whether a build matches its design."
    />
    <div class="[ proc-grid ] [ grid ]">
      {steps.map((s) => (
        <div class="proc reveal">
          <div class="[ proc-n ] [ bg-accent-soft text-accent ]">{s.n}</div>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Layout = .grid (markup) + border-top-line; accent chip colour = utilities. */
  .proc-grid { --grid-space: 22px; grid-template-columns: repeat(4, 1fr); margin-top: 8px; }
  .proc { padding: 26px 22px; border-radius: 18px; border: 1px solid var(--line); background: var(--paper); }
  .proc-n {
    font-family: var(--display);
    font-weight: 600;
    font-size: 15px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    margin-bottom: 16px;
  }
  .proc h3 { font-family: var(--display); font-weight: 600; font-size: 18px; letter-spacing: -.01em; margin-bottom: 8px; }
  .proc p { font-size: 14px; color: var(--ink-2); line-height: 1.55; }

  @media (max-width: 820px) { .proc-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .proc-grid { grid-template-columns: 1fr; } }
</style>
