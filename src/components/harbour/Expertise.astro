---
/** Expertise — a chart legend of what I bring, each line naming the work that proves it. */
import Head from './Head.astro';
const rows = [
  { t: 'WooCommerce stores', d: 'Stores built for how people actually buy: phone first, cash on delivery, courier booking, SMS codes, server side tracking with Meta CAPI and GA4.', p: 'Hermizon' },
  { t: 'Plugin development', d: 'PHP plugins that pass WordPress.org review, with PHPStan, PHPCS and releases that can be rolled back.', p: 'ShopCurator · SchedulePress' },
  { t: 'MCP and AI integrations', d: 'Connecting AI assistants to real systems safely: a preview before every write, signed confirm tokens, admin switches, rate limits, OAuth.', p: 'Hermizon · SchedulePress' },
  { t: 'Elementor and Gutenberg', d: '40+ production template packs, pixel perfect at every breakpoint, built on Templately’s Global Style and Typography.', p: 'Templately' },
  { t: 'Deployment and operations', d: 'Hosting, staging and git based deploys: launch runbooks with a gate at the end, separate code and database rollbacks, email DNS.', p: 'Hermizon · this site' },
  { t: 'Performance', d: 'Measured first, then fixed: page weight, Critical CSS, Core Web Vitals from real users, not only lab scores.', p: 'Hermizon · this site' },
];
const toolkit: [string, string[]][] = [
  ['WordPress', ['WordPress', 'WooCommerce', 'Elementor', 'Gutenberg', 'Block themes', 'Global Style & Typography']],
  ['Backend', ['PHP', 'MySQL', 'REST API', 'WP CLI', 'Composer', 'PHPStan', 'MCP', 'OAuth']],
  ['Frontend', ['HTML', 'CSS', 'JavaScript', 'React', 'Astro', 'WebGPU', 'Figma to code']],
  ['Ship', ['Git', 'GitHub Actions', 'Netlify', 'Cloudflare', 'xCloud', 'WordPress.org SVN']],
  ['Also', ['Python', 'Rust (learning)', 'SEO aware development']],
];
---
<section class="expertise" id="expertise" aria-labelledby="exp-h">
  <div class="wrapper">
    <Head id="exp-h" title="What I bring to a team" sub="Over five years of production WordPress, and everything it takes to get a product live." />
    <div class="legend rise">
      {rows.map((r) => <div class="row"><h3>{r.t}</h3><p>{r.d}</p><span class="proof">{r.p}</span></div>)}
    </div>
    <dl class="toolkit rise">
      {toolkit.map(([g, items]) => <div><dt>{g}</dt><dd>{items.map((i) => <span>{i}</span>)}</dd></div>)}
    </dl>
  </div>
</section>

<style>
  .expertise { padding: var(--section-y) 0; }
  .legend { border-top: 1px solid var(--trace); }
  .row { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.3fr) minmax(0, .6fr); gap: 30px; align-items: baseline; padding: 30px 0; border-bottom: 1px solid var(--trace); }
  h3 { margin: 0; font-family: var(--display); font-weight: 200; font-size: clamp(24px, 2.6vw, 32px); letter-spacing: -.01em; }
  p { margin: 0; color: var(--ink-2); font-size: 15.5px; }
  .proof { justify-self: end; text-align: right; font-family: var(--display); font-size: 12.5px; letter-spacing: .16em; text-transform: uppercase; color: var(--lume); }
  .toolkit { display: grid; gap: 14px; margin: 48px 0 0; }
  .toolkit div { display: grid; grid-template-columns: 120px 1fr; gap: 20px; align-items: baseline; }
  dt { font-family: var(--display); font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--dim); }
  dd { display: flex; flex-wrap: wrap; gap: 2px 10px; margin: 0; color: var(--mist); font-size: 15px; }
  dd span { white-space: nowrap; }
  dd span:not(:last-child)::after { content: "·"; margin-left: 10px; color: var(--dim); }
  @media (max-width: 820px) { .row { grid-template-columns: 1fr; gap: 8px; } .proof { justify-self: start; text-align: left; } }
  @media (max-width: 600px) { .toolkit div { grid-template-columns: 1fr; gap: 4px; } }
</style>
