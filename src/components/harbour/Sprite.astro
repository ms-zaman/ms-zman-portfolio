---
/**
 * Sprite — the one authored icon set for the site, drawn in a single 1.2–1.4
 * stroke so every glyph shares a weight. Referenced with <use href="#id">.
 */
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <symbol id="i-arrow" viewBox="0 0 46 10"><path d="M1 5h4M9 5h4M17 5h4M25 5h17" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><path d="M38 1l4.5 4L38 9" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="i-ext" viewBox="0 0 16 16"><path d="M5 11L11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="i-mail" viewBox="0 0 20 20"><rect x="2.5" y="4.5" width="15" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M3 5.5l7 5.2 7-5.2" fill="none" stroke="currentColor" stroke-width="1.3"/></symbol>
    <symbol id="i-chat" viewBox="0 0 20 20"><path d="M4 15.5l1-3.2A6.5 6.5 0 1 1 8 15l-4 .5z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></symbol>
    <symbol id="i-code" viewBox="0 0 20 20"><path d="M7 6l-4 4 4 4M13 6l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="i-linkedin" viewBox="0 0 20 20"><rect x="3" y="3" width="14" height="14" rx="3" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M7 9v4.5M7 6.6v.1M10 13.5V9.6M10 11a2 2 0 0 1 4 0v2.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></symbol>
    <symbol id="i-github" viewBox="0 0 24 24"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="i-mark" viewBox="0 0 34 34"><circle cx="17" cy="17" r="16" fill="none" stroke="#22374f"/><g fill="#66f6ff"><circle cx="17" cy="9.5" r="1.6"/><circle cx="12.5" cy="14" r="1.4"/><circle cx="21.5" cy="14" r="1.4"/><circle cx="17" cy="16" r="1.9"/><circle cx="10" cy="20" r="1.1"/><circle cx="14.5" cy="21" r="1.5"/><circle cx="19.5" cy="21" r="1.5"/><circle cx="24" cy="20" r="1.1"/><circle cx="17" cy="25" r="1.2"/></g></symbol>
  </defs>
</svg>
