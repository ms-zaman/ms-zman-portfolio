---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

// Generate a static page for every blog post at build time
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  // newest first, so "previous" reads as older and "next" as newer
  const ordered = posts.sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
  );
  return ordered.map((post, i) => ({
    params: { slug: post.data.slug || post.id },
    props: { post, newer: ordered[i - 1] ?? null, older: ordered[i + 1] ?? null },
  }));
}

const { post, newer, older } = Astro.props;
const linkTo = (p: (typeof newer)) => (p ? `/blog/${p.data.slug || p.id}` : null);
const { Content } = await render(post);

const formattedDate = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const slug = post.data.slug || post.id;

// Rough but honest: the markdown body minus fences, for schema.org wordCount.
const wordCount = post.body
  ? post.body.replace(/```[\s\S]*?```/g, ' ').split(/\s+/).filter(Boolean).length
  : 0;
---

<BlogLayout
  title={`${post.data.title} — Sharfuzzaman`}
  description={post.data.description}
  ogTitle={post.data.title}
  ogDescription={post.data.description}
  {...(post.data.cover ? { ogImage: post.data.cover } : {})}
  canonicalPath={`/blog/${slug}`}
  markdownPath={`/blog/${slug}.md`}
  article={{
    title: post.data.title,
    description: post.data.description,
    date: post.data.date,
    tags: post.data.tags,
    readTime: post.data.readTime,
    wordCount,
  }}
>
  <article class="[ blog-post-page ] [ wrapper ]">
    <a href="/blog" class="back-link">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      Back to articles
    </a>

    <header class="post-header">
      <div class="post-meta-top">
        <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
        <span class="dot-separator">•</span>
        <span>{post.data.readTime}</span>
      </div>

      <h1 class="post-title-main">{post.data.title}</h1>

      <div class="post-tags">
        {post.data.tags.map((tag) => (
          <span class="post-tag-chip">#{tag}</span>
        ))}
      </div>
    </header>

    {post.data.cover && (
      <figure class="post-cover">
        <Image
          src={post.data.cover}
          alt={post.data.coverAlt ?? ''}
          widths={[640, 960, 1536]}
          sizes="(max-width: 800px) 100vw, 760px"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    )}

    <div class="post-content-wrapper markdown-content">
      <Content />
    </div>

    {/* A reader who finishes a post used to hit nothing at all — no next post, no
        author, no way to get in touch. This is the only place the blog can turn a
        reader into a conversation, so it says who wrote it and offers both. */}
    <footer class="post-end">
      {(newer || older) && (
        <nav class="post-nav" aria-label="More articles">
          {older && (
            <a class="post-nav-link" href={linkTo(older)} rel="prev">
              <span class="post-nav-dir">← Older</span>
              <span class="post-nav-title">{older.data.title}</span>
            </a>
          )}
          {newer && (
            <a class="post-nav-link post-nav-link--next" href={linkTo(newer)} rel="next">
              <span class="post-nav-dir">Newer →</span>
              <span class="post-nav-title">{newer.data.title}</span>
            </a>
          )}
        </nav>
      )}

      <div class="post-author">
        <span class="post-author-mark" aria-hidden="true">S</span>
        <div class="post-author-text">
          <p class="post-author-name">Sharfuzzaman</p>
          <p class="post-author-role">
            WordPress Developer specializing in Elementor &amp; Gutenberg, in Dhaka (GMT+6).
            <strong>Open to remote opportunities.</strong>
          </p>
        </div>
        <div class="post-author-cta">
          <a class="post-cta post-cta--solid" href="/#contact">Get in touch</a>
          <a class="post-cta" href="/Sharfuzzaman-Resume.pdf" target="_blank" rel="noopener">Résumé</a>
        </div>
      </div>
    </footer>
  </article>
</BlogLayout>
