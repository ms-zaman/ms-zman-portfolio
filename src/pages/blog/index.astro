---
import BlogLayout from '../../layouts/BlogLayout.astro';
import BlogSearch from '../../components/BlogSearch.jsx';
import { getCollection } from 'astro:content';

// Fetch all blog posts at build time
const allPosts = await getCollection('blog');

// Sort by date (newest first)
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);

// Serialize post metadata for the React island (no body content — keep payload small)
const postsForSearch = sortedPosts.map((post) => ({
  slug: post.data.slug || post.id,
  title: post.data.title,
  description: post.data.description,
  date: post.data.date.toISOString(),
  tags: post.data.tags,
  readTime: post.data.readTime,
}));
---

<BlogLayout
  title="Articles & Thoughts on Web Engineering — Sharfuzzaman"
  description="Notes on frontend engineering, the things I build at work, and whatever I am digging into at the moment."
  ogTitle="Articles & Thoughts on Web Engineering — Sharfuzzaman"
  ogDescription="Notes on frontend engineering, the things I build at work, and whatever I am digging into at the moment."
  canonicalPath="/blog"
>
  <div class="[ blog-page ] [ wrapper ]">
    <header class="page-header">
      <h1 class="page-title">Thoughts & Engineering</h1>
      <p class="page-subtitle">
        Notes on frontend engineering, the things I build at work, and whatever I am digging into at the moment.
      </p>
    </header>

    <BlogSearch client:visible posts={postsForSearch} />
  </div>
</BlogLayout>
