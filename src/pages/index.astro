---
/**
 * Home (/) — Night Harbour. The harbour at night: a WebGPU sea in the hero,
 * the departures board of what shipped, four live products as buoys on one
 * current, then craft, expertise, lab, experience, gates and contact.
 * The blog/404 share the same tokens via BlogLayout.
 */
import HarbourLayout from '../layouts/HarbourLayout.astro';
import Nav from '../components/harbour/Nav.astro';
import Hero from '../components/harbour/Hero.astro';
import Departures from '../components/harbour/Departures.astro';
import Work from '../components/harbour/Work.astro';
import Craft from '../components/harbour/Craft.astro';
import Expertise from '../components/harbour/Expertise.astro';
import Lab from '../components/harbour/Lab.astro';
import Experience from '../components/harbour/Experience.astro';
import Gates from '../components/harbour/Gates.astro';
import Contact from '../components/harbour/Contact.astro';
import Footer from '../components/harbour/Footer.astro';
---
<HarbourLayout>
  <Nav home />
  <main>
    <Hero />
    <Departures />
    <Work />
    <Craft />
    <Expertise />
    <Lab />
    <Experience />
    <Gates />
    <Contact />
  </main>
  <Footer />
</HarbourLayout>
